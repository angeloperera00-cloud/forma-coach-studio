# ─────────────────────────────────────────────────────────────────────────────
# Forma · Coach Studio — environment template
# Copy to .env.local and fill in. Nothing here is ever sent to the browser.
# With NO variables set, the app runs in demo mode (local JSON data) and you can
# sign in with coach@forma.demo / forma-demo-2026.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase) ──────────────────────────────────────────────────────
# When both are set, all data is read/written in Supabase instead of .demo-data/.
# The service role key bypasses RLS: keep it server-side only (never NEXT_PUBLIC_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Coach sign-in ────────────────────────────────────────────────────────────
# Sign-in is OFF by default (no login page). Set to true once sign-in is tested.
REQUIRE_LOGIN=false
# Clients never need an account.
# Supabase Auth: this verified email becomes the first administrator.
# Local sign-in: the single email allowed to sign in.
COACH_EMAIL=

# Option A — Supabase Auth (Google, Facebook, Apple, email/username, SMS; multiple coaches).
# Enabled when SUPABASE_URL + one of these public keys + SUPABASE_SERVICE_ROLE_KEY are set.
# Provider setup: docs/AUTH_SETUP.md
SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# Public URL of the site, used for OAuth and email links (no trailing slash).
SITE_URL=

# Option B — local sign-in (no Supabase Auth): password checked on the server,
# session kept in a signed httpOnly cookie.
COACH_PASSWORD=
# Required in production for option B: at least 32 random characters,
# e.g. `openssl rand -base64 48`. In demo mode a secret is generated in .demo-data/.
AUTH_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# Time zone used for "today", calendars and reminders (default Europe/Rome).
NEXT_PUBLIC_APP_TIMEZONE=Europe/Rome
# Where demo mode stores its JSON database and uploads (default ./.demo-data).
# DEMO_DATA_DIR=
